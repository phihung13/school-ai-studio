*.db
*.db-wal
*.db-shm
*.bak-*
/data/studio.db*
# binary tool bên thứ ba (ffmpeg/ffprobe/typst) — không commit, cài/tải riêng trên máy
*.exe
/data/db.json
/data/.impeccable/
/data/import/
# bộ bàn giao tutor (ngân hàng đề KÈM ĐÁP ÁN) — đã giao qua import, KHÔNG đưa lên repo public
